{
  "tasks": {
    "start": "deno run -A --watch=static/,routes/ dev.ts",
    "build": "deno run -A dev.ts build",
    "preview": "deno run -A main.ts"
  },
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "preact": "https://esm.sh/preact@10.29.1",
    "preact/": "https://esm.sh/preact@10.29.1/",
    "preact-render-to-string": "https://esm.sh/*preact-render-to-string@6.6.7",
    "preact-markdown": "https://esm.sh/react-markdown@10.1.0?alias=react:preact/compat",
    "remark-directive": "https://esm.sh/remark-directive@4.0.0",
    "remark-directive-rehype": "https://esm.sh/remark-directive-rehype@1.0.0",
    "remark-gfm": "https://esm.sh/remark-gfm@4.0.1",
    "twind": "https://esm.sh/twind@0.16.19",
    "twind/": "https://esm.sh/twind@0.16.19/",
    "twind-preset-tailwind": "https://esm.sh/@twind/preset-tailwind@1.1.4",
    "twind-preset-typography": "https://esm.sh/@twind/preset-typography@1.0.7",
    "photoswipe": "https://esm.sh/photoswipe@5.4.4",
    "photoswipe/": "https://esm.sh/photoswipe@5.4.4/",
    "d3": "https://esm.sh/d3@7.9.0",
    "ol/": "https://esm.sh/ol@10.9.0/",
    "computed-types": "npm:computed-types@1.11.2",
    "preactify-markdown/": "https://raw.githubusercontent.com/Tims777/preactify-markdown/0.3.1/",
    "@preact/signals": "https://esm.sh/*@preact/signals@2.9.0",
    "@preact/signals-core": "https://esm.sh/*@preact/signals-core@1.14.1"
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": ["**/_fresh/*"]
}
